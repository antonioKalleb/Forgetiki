<!DOCTYPE html>
<html lang="pt-br">
<%- include('partials/head') %>
<body>
  <%- include('partials/navbar') %>
  <main class="container my-5">
    <h1 class="font-brand text-accent mb-4">Fandoms & Jogos Cadastrados</h1>
    <p class="text-muted mb-4">Comunidades de jogos desafiadores, cults e subestimados.</p>

    <div class="row g-4">
      <% games.forEach(game => { %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card bg-dark text-light border-secondary h-100 p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="badge bg-danger">Dificuldade: <%= game.difficulty %></span>
              <small class="text-muted"><%= game.genre %></small>
            </div>
            <h4 class="text-accent font-brand"><%= game.name %></h4>
            <p class="text-muted small flex-grow-1"><%= game.description %></p>
            <a href="/guides/new" class="btn btn-outline-cyan btn-sm mt-2">Criar Guia para este Jogo</a>
          </div>
        </div>
      <% }) %>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>