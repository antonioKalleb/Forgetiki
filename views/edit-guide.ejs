<!DOCTYPE html>
<html lang="pt-br">
<%- include('partials/head') %>
<body>
  <%- include('partials/navbar') %>
  <main class="container my-5" style="max-width: 600px;">
    <div class="card p-4 bg-dark text-light border-secondary">
      <h2 class="font-brand text-accent mb-4">Editar Guia</h2>
      
      <form action="/guides/<%= guide.id %>/edit" method="POST">
        <div class="mb-3">
          <label for="title" class="form-label text-light">Título do Guia</label>
          <input type="text" id="title" name="title" class="form-control bg-dark text-light border-secondary" value="<%= guide.title %>" required>
        </div>

        <div class="mb-3">
          <label for="game" class="form-label text-light">Jogo / Fandom</label>
          <select id="game" name="game" class="form-select bg-dark text-light border-secondary" required>
            <option value="Chrono Trigger" <%= guide.game === 'Chrono Trigger' ? 'selected' : '' %>>Chrono Trigger</option>
            <option value="Golden Sun" <%= guide.game === 'Golden Sun' ? 'selected' : '' %>>Golden Sun</option>
            <option value="Vagrant Story" <%= guide.game === 'Vagrant Story' ? 'selected' : '' %>>Vagrant Story</option>
            <option value="Okami" <%= guide.game === 'Okami' ? 'selected' : '' %>>Okami</option>
          </select>
        </div>

        <div class="mb-3">
          <label for="content" class="form-label text-light">Conteúdo do Guia</label>
          <textarea id="content" name="content" rows="5" class="form-control bg-dark text-light border-secondary" required><%= guide.content %></textarea>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary-custom w-100">Salvar Alterações</button>
          <a href="/guides/<%= guide.id %>" class="btn btn-outline-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>