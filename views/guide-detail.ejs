<!DOCTYPE html>
<html lang="pt-br">
<%- include('partials/head') %>
<body>
  <%- include('partials/navbar') %>
  <main class="container my-5" style="max-width: 820px;">
    <a href="/guides" class="btn btn-outline-secondary btn-sm mb-3">← Voltar para Central de Posts</a>

    <% if (typeof feedback !== 'undefined' && feedback === 'unauthorized') { %>
      <div class="alert alert-warning border-warning mb-3" role="alert">
        🔒 <strong>Ação não permitida:</strong> apenas o autor original pode editar este conteúdo.
      </div>
    <% } %>

    <% if (typeof feedback !== 'undefined' && feedback === 'reported') { %>
      <div class="alert alert-success border-success mb-3" role="alert">
        🚩 <strong>Denúncia enviada!</strong> Nossa moderação analisará o comentário em breve.
      </div>
    <% } %>

    <div class="card p-4 bg-dark text-light border-secondary mb-4">
      <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <a href="/games/<%= encodeURIComponent(guide.game) %>" class="badge bg-secondary text-decoration-none">
          🎮 <%= guide.game %>
        </a>
        <a href="/guides?category=<%= encodeURIComponent(guide.category || 'Guia') %>" class="badge bg-info text-dark text-decoration-none">
          📌 <%= guide.category || 'Guia' %>
        </a>
        <div class="d-flex align-items-center gap-1 ms-auto flex-wrap">
          <small class="text-light opacity-75">
            ✍️ Por <strong><%= guide.authorName || 'Admin' %></strong>
          </small>
          <% if (guide.authorId) { %>
            <span class="badge bg-dark border border-secondary text-light d-inline-flex align-items-center gap-1" style="font-size: 0.72rem;">
              ID #<%= guide.authorId %>
              <button type="button" class="btn btn-link p-0 text-info text-decoration-none d-inline-flex align-items-center" title="Copiar ID do autor" onclick="copyTextId('<%= guide.authorId %>', this)">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
              </button>
            </span>
          <% } %>
          <% if (guide.createdAt) { %>
            <small class="text-light opacity-50">• <%= guide.createdAt %></small>
          <% } %>
        </div>
      </div>

      <h1 class="font-brand text-accent mb-2"><%= guide.title %></h1>

      <% if (guide.tags && guide.tags.length > 0) { %>
        <div class="d-flex flex-wrap gap-2 mb-3">
          <% guide.tags.forEach(t => { %>
            <a href="/guides?tag=<%= encodeURIComponent(t) %>" class="badge bg-dark border border-info text-info text-decoration-none">#<%= t %></a>
          <% }) %>
        </div>
      <% } %>

      <% if (guide.imageUrl) { %>
        <div class="my-3 text-center">
          <img src="<%= guide.imageUrl %>" alt="<%= guide.title %>" class="img-fluid rounded border border-secondary" style="max-height: 450px;">
        </div>
      <% } %>

      <% 
        const allLinks = (guide.links && guide.links.length > 0) ? guide.links : (guide.videoUrl ? [guide.videoUrl] : []);
        const ytEmbeds = allLinks.map(l => getYoutubeEmbedUrl(l)).filter(Boolean);
      %>

      <% if (ytEmbeds.length > 0) { %>
        <% ytEmbeds.forEach(embedUrl => { %>
          <div class="ratio ratio-16x9 my-3">
            <iframe src="<%= embedUrl %>" title="Vídeo Incorporado" allowfullscreen class="rounded border border-secondary"></iframe>
          </div>
        <% }) %>
      <% } %>

      <p class="text-light mt-3 fs-5" style="white-space: pre-line;"><%= guide.content %></p>

      <!-- SEÇÃO DE LINKS & REFERÊNCIAS -->
      <% if (allLinks.length > 0) { %>
        <div class="mt-4 p-3 rounded border border-secondary" style="background-color: #13131f;">
          <small class="text-light opacity-75 d-block mb-2">🔗 Links & Referências anexados:</small>
          <div class="d-flex flex-column gap-2">
            <% allLinks.forEach(link => { %>
              <a href="<%= link %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-info text-start text-truncate">
                ↗ <%= link %>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (canEditGuide || canDeleteGuide) { %>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-4 pt-3 border-top border-secondary">
          <% if (canEditGuide) { %>
            <a href="/guides/<%= guide.id %>/edit" class="btn btn-warning btn-sm">✏️ Editar Post</a>
          <% } %>
          <% if (canDeleteGuide) { %>
            <form action="/guides/<%= guide.id %>/delete" method="POST" class="m-0" onsubmit="return confirm('Tem certeza que deseja excluir esta postagem?');">
              <button type="submit" class="btn btn-danger btn-sm">🗑️ Excluir Post</button>
            </form>
          <% } %>
          <% if (!canEditGuide && canDeleteGuide) { %>
            <small class="text-light opacity-50 ms-auto">🛡️ Moderação: apenas <strong><%= guide.authorName || 'Admin' %></strong> pode editar o texto.</small>
          <% } %>
        </div>
      <% } else { %>
        <div class="mt-4 pt-3 border-top border-secondary">
          <small class="text-light opacity-50">🔒 Apenas <strong><%= guide.authorName || 'Admin' %></strong> pode editar este post.</small>
        </div>
      <% } %>
    </div>

    <!-- SEÇÃO DE COMENTÁRIOS -->
    <div class="card p-4 bg-dark text-light border-secondary">
      <h4 class="font-brand text-accent mb-3">
        💬 Comentários (<%= typeof guide.totalComments !== 'undefined' ? guide.totalComments : (guide.comments ? guide.comments.length : 0) %>)
      </h4>

      <form action="/guides/<%= guide.id %>/comments" method="POST" class="mb-4">
        <div class="mb-2">
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <div class="form-check mb-2">
              <input 
                class="form-check-input" 
                type="checkbox" 
                name="useAccount" 
                value="1" 
                id="use-account-main" 
                checked 
                onchange="toggleAccountMode('main', this)"
              >
              <label class="form-check-label small text-light opacity-75" for="use-account-main">
                Comentar usando minha conta (<strong><%= currentUser.username %></strong> • ID #<%= currentUser.id %>)
              </label>
            </div>
            <input 
              type="text" 
              id="author-input-main"
              name="author" 
              class="form-control bg-dark text-info border-secondary" 
              value="👤 <%= currentUser.username %> (ID #<%= currentUser.id %>)"
              data-account-label="👤 <%= currentUser.username %> (ID #<%= currentUser.id %>)"
              readonly
            >
          <% } else { %>
            <input 
              type="text" 
              name="author" 
              class="form-control bg-dark text-light border-secondary" 
              placeholder="Seu apelido como visitante (opcional)..."
            >
          <% } %>
        </div>
        <div class="mb-2">
          <textarea name="text" rows="2" class="form-control bg-dark text-light border-secondary" placeholder="Escreva uma dica, dúvida ou feedback..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary-custom btn-sm">Enviar Comentário</button>
      </form>

      <% if (!guide.comments || guide.comments.length === 0) { %>
        <p class="text-light opacity-75 small m-0">Nenhum comentário ainda. Seja o primeiro a comentar!</p>
      <% } else { %>
        <div class="d-flex flex-column gap-3">
          <% guide.comments.forEach(comment => { %>
            <div class="p-3 rounded border border-secondary" style="background-color: #13131f;">
              
              <!-- Cabeçalho do Comentário Principal -->
              <div class="d-flex justify-content-between align-items-center mb-1">
                <div class="d-flex align-items-center gap-2">
                  <strong class="text-accent"><%= comment.author %></strong>
                  <small class="text-light opacity-50" style="font-size: 0.75rem;">
                    <%= comment.createdAt %> <%= comment.edited ? '(editado)' : '' %>
                  </small>
                </div>

                <div class="d-flex align-items-center gap-1">
                  <% if (comment.canEdit) { %>
                    <button type="button" class="btn btn-sm text-light opacity-75 p-1 border-0" title="Editar comentário" onclick="toggleEditComment('<%= comment.id %>')">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                      </svg>
                    </button>
                  <% } %>

                  <% if (comment.canDelete) { %>
                    <form action="/guides/<%= guide.id %>/comments/<%= comment.id %>/delete" method="POST" class="m-0 d-inline" onsubmit="return confirm('Apagar este comentário e suas respostas?');">
                      <button type="submit" class="btn btn-sm text-light opacity-75 p-1 border-0" title="Apagar comentário">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                          <path d="M10 11v6"></path>
                          <path d="M14 11v6"></path>
                          <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                        </svg>
                      </button>
                    </form>
                  <% } %>

                  <!-- Ícone de Conta (Boneco inteiro azul) vs Visitante (Boneco cortado) -->
                  <% if (comment.authorId) { %>
                    <span class="d-inline-flex align-items-center justify-content-center px-1" title="Usuário com conta (ID #<%= comment.authorId %>)" style="color: #38bdf8;">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                        <circle cx="12" cy="7" r="4"></circle>
                        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7v1H4v-1z"></path>
                      </svg>
                    </span>
                  <% } else { %>
                    <span class="d-inline-flex align-items-center justify-content-center px-1 text-secondary" title="Visitante (sem conta)">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <g opacity="0.65" fill="currentColor">
                          <path d="M12 3a4 4 0 0 0-2.8 6.8L12 7V3z"></path>
                          <path d="M4 20c0-3.5 2.7-6.3 6.3-6.9L4 19.4V20z"></path>
                        </g>
                        <line x1="4" y1="20" x2="20" y2="4" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"></line>
                      </svg>
                    </span>
                  <% } %>

                  <!-- Menu 3 pontos: visível para TODOS (mostra ID da conta quando houver) -->
                  <div class="dropdown">
                    <button class="btn btn-sm text-light opacity-75 p-1 border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Mais opções">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                        <circle cx="12" cy="5" r="2"></circle>
                        <circle cx="12" cy="12" r="2"></circle>
                        <circle cx="12" cy="19" r="2"></circle>
                      </svg>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-secondary shadow">
                      <% if (comment.authorId) { %>
                        <li class="px-3 py-1 d-flex align-items-center justify-content-between gap-2 small text-light opacity-75">
                          <span>🆔 ID: <strong class="text-info">#<%= comment.authorId %></strong></span>
                          <button type="button" class="btn btn-sm btn-outline-info py-0 px-2" style="font-size: 0.7rem;" onclick="event.stopPropagation(); copyTextId('<%= comment.authorId %>', this)">
                            Copiar
                          </button>
                        </li>
                      <% } else { %>
                        <li class="px-3 py-1 small text-light opacity-50">
                          👤 Visitante (sem conta)
                        </li>
                      <% } %>
                      <li><hr class="dropdown-divider border-secondary"></li>
                      <% if (comment.canEdit) { %>
                        <li>
                          <button type="button" class="dropdown-item small" onclick="toggleEditComment('<%= comment.id %>')">
                            ✏️ Editar comentário
                          </button>
                        </li>
                      <% } %>
                      <% if (comment.canDelete) { %>
                        <li>
                          <form action="/guides/<%= guide.id %>/comments/<%= comment.id %>/delete" method="POST" onsubmit="return confirm('Apagar este comentário e suas respostas?');">
                            <button type="submit" class="dropdown-item small text-danger">
                              🗑️ Excluir comentário
                            </button>
                          </form>
                        </li>
                      <% } %>
                      <% if (comment.canEdit || comment.canDelete) { %>
                        <li><hr class="dropdown-divider border-secondary"></li>
                      <% } %>
                      <li>
                        <button type="button" class="dropdown-item small text-warning" onclick="toggleReportComment('<%= comment.id %>')">
                          ⚠️ Denunciar comentário
                        </button>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Texto do Comentário Principal -->
              <p id="comment-text-<%= comment.id %>" class="text-light mb-2 small" style="white-space: pre-line;"><%= comment.text %></p>

              <!-- Form de Edição Inline (Autor) -->
              <% if (comment.canEdit) { %>
                <form id="comment-edit-<%= comment.id %>" action="/guides/<%= guide.id %>/comments/<%= comment.id %>/edit" method="POST" class="mt-2 mb-2 d-none">
                  <textarea name="text" rows="2" class="form-control form-control-sm bg-dark text-light border-secondary mb-2" required><%= comment.text %></textarea>
                  <div class="d-flex gap-2 justify-content-end">
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleEditComment('<%= comment.id %>')">Cancelar</button>
                    <button type="submit" class="btn btn-primary-custom btn-sm">Salvar</button>
                  </div>
                </form>
              <% } %>

              <!-- Form de Denúncia Inline (Todos) -->
              <form id="comment-report-<%= comment.id %>" action="/guides/<%= guide.id %>/comments/<%= comment.id %>/report" method="POST" class="mt-2 mb-2 p-2 rounded border border-warning bg-dark d-none">
                <small class="text-warning fw-bold d-block mb-1">⚠️ Denunciar comentário de <%= comment.author %></small>
                <select name="reason" class="form-select form-select-sm bg-dark text-light border-secondary mb-2">
                  <option value="Spam ou propaganda">Spam ou propaganda</option>
                  <option value="Ofensa ou assédio">Ofensa ou assédio</option>
                  <option value="Spoiler sem aviso">Spoiler sem aviso</option>
                  <option value="Conteúdo inadequado">Conteúdo inadequado</option>
                </select>
                <input type="text" name="details" class="form-control form-control-sm bg-dark text-light border-secondary mb-2" placeholder="Detalhes adicionais (opcional)...">
                <div class="d-flex gap-2 justify-content-end">
                  <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleReportComment('<%= comment.id %>')">Cancelar</button>
                  <button type="submit" class="btn btn-warning btn-sm">Enviar Denúncia</button>
                </div>
              </form>

              <!-- Barra de Ações Estilo YouTube: Responder + Ver/Ocultar Respostas -->
              <div class="d-flex align-items-center gap-3 mt-1">
                <button 
                  type="button" 
                  class="btn btn-sm btn-link text-info p-0 text-decoration-none d-inline-flex align-items-center gap-1" 
                  style="font-size: 0.82rem;"
                  data-parent-id="<%= comment.id %>"
                  data-mention=""
                  onclick="openReplyForm(this)"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 17 4 12 9 7"></polyline>
                    <path d="M20 18v-2a4 4 0 0 0-4-4H4"></path>
                  </svg>
                  Responder
                </button>

                <% if (comment.replies && comment.replies.length > 0) { %>
                  <button 
                    type="button" 
                    id="toggle-replies-btn-<%= comment.id %>" 
                    class="btn btn-sm btn-link p-0 text-decoration-none fw-semibold" 
                    style="color: #a78bfa; font-size: 0.82rem;"
                    data-comment-id="<%= comment.id %>"
                    data-count="<%= comment.replies.length %>"
                    onclick="toggleReplies(this)"
                  >
                    &#9652; Ocultar <%= comment.replies.length %> <%= comment.replies.length === 1 ? 'resposta' : 'respostas' %>
                  </button>
                <% } %>
              </div>

              <!-- Formulário de Resposta Estilo YouTube -->
              <form id="reply-form-<%= comment.id %>" action="/guides/<%= guide.id %>/comments" method="POST" class="mt-3 ps-3 border-start border-secondary d-none">
                <input type="hidden" name="parentId" value="<%= comment.id %>">
                <div class="mb-2">
                  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <div class="form-check mb-2">
                      <input 
                        class="form-check-input" 
                        type="checkbox" 
                        name="useAccount" 
                        value="1" 
                        id="use-account-reply-<%= comment.id %>" 
                        checked 
                        onchange="toggleAccountMode('reply-<%= comment.id %>', this)"
                      >
                      <label class="form-check-label small text-light opacity-75" for="use-account-reply-<%= comment.id %>">
                        Responder usando minha conta (<strong><%= currentUser.username %></strong> • ID #<%= currentUser.id %>)
                      </label>
                    </div>
                    <input 
                      type="text" 
                      id="author-input-reply-<%= comment.id %>"
                      name="author" 
                      class="form-control form-control-sm bg-dark text-info border-secondary" 
                      value="👤 <%= currentUser.username %> (ID #<%= currentUser.id %>)"
                      data-account-label="👤 <%= currentUser.username %> (ID #<%= currentUser.id %>)"
                      readonly
                    >
                  <% } else { %>
                    <input 
                      type="text" 
                      name="author" 
                      class="form-control form-control-sm bg-dark text-light border-secondary" 
                      placeholder="Seu apelido como visitante (opcional)..."
                    >
                  <% } %>
                </div>
                <div class="mb-2">
                  <textarea 
                    id="reply-textarea-<%= comment.id %>" 
                    name="text" 
                    rows="2" 
                    class="form-control form-control-sm bg-dark text-light border-secondary" 
                    placeholder="Adicione uma resposta..." 
                    required
                  ></textarea>
                </div>
                <div class="d-flex gap-2 justify-content-end">
                  <button type="button" class="btn btn-outline-secondary btn-sm" onclick="closeReplyForm('<%= comment.id %>')">Cancelar</button>
                  <button type="submit" class="btn btn-primary-custom btn-sm">Responder</button>
                </div>
              </form>

              <!-- Lista de Respostas (Thread Estilo YouTube) -->
              <% if (comment.replies && comment.replies.length > 0) { %>
                <div id="replies-list-<%= comment.id %>" class="mt-3 ms-2 ps-3 border-start border-secondary d-flex flex-column gap-2">
                  <% comment.replies.forEach(reply => { %>
                    <div class="p-2 rounded border border-secondary bg-dark bg-opacity-50">
                      
                      <div class="d-flex justify-content-between align-items-center mb-1">
                        <div class="d-flex align-items-center gap-2">
                          <strong class="text-accent small"><%= reply.author %></strong>
                          <small class="text-light opacity-50" style="font-size: 0.72rem;">
                            <%= reply.createdAt %> <%= reply.edited ? '(editado)' : '' %>
                          </small>
                        </div>

                        <div class="d-flex align-items-center gap-1">
                          <% if (reply.canEdit) { %>
                            <button type="button" class="btn btn-sm text-light opacity-75 p-1 border-0" title="Editar resposta" onclick="toggleEditComment('<%= reply.id %>')">
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                              </svg>
                            </button>
                          <% } %>

                          <% if (reply.canDelete) { %>
                            <form action="/guides/<%= guide.id %>/comments/<%= reply.id %>/delete" method="POST" class="m-0 d-inline" onsubmit="return confirm('Apagar esta resposta?');">
                              <button type="submit" class="btn btn-sm text-light opacity-75 p-1 border-0" title="Apagar resposta">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                  <polyline points="3 6 5 6 21 6"></polyline>
                                  <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                                  <path d="M10 11v6"></path>
                                  <path d="M14 11v6"></path>
                                  <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                                </svg>
                              </button>
                            </form>
                          <% } %>

                          <!-- Ícone de Conta (Boneco inteiro azul) vs Visitante (Boneco cortado) -->
                          <% if (reply.authorId) { %>
                            <span class="d-inline-flex align-items-center justify-content-center px-1" title="Usuário com conta (ID #<%= reply.authorId %>)" style="color: #38bdf8;">
                              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                                <circle cx="12" cy="7" r="4"></circle>
                                <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7v1H4v-1z"></path>
                              </svg>
                            </span>
                          <% } else { %>
                            <span class="d-inline-flex align-items-center justify-content-center px-1 text-secondary" title="Visitante (sem conta)">
                              <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                                <g opacity="0.65" fill="currentColor">
                                  <path d="M12 3a4 4 0 0 0-2.8 6.8L12 7V3z"></path>
                                  <path d="M4 20c0-3.5 2.7-6.3 6.3-6.9L4 19.4V20z"></path>
                                </g>
                                <line x1="4" y1="20" x2="20" y2="4" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"></line>
                              </svg>
                            </span>
                          <% } %>

                          <!-- Menu 3 pontos na resposta: visível para TODOS -->
                          <div class="dropdown">
                            <button class="btn btn-sm text-light opacity-75 p-1 border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Mais opções">
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <circle cx="12" cy="5" r="2"></circle>
                                <circle cx="12" cy="12" r="2"></circle>
                                <circle cx="12" cy="19" r="2"></circle>
                              </svg>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-secondary shadow">
                              <% if (reply.authorId) { %>
                                <li class="px-3 py-1 d-flex align-items-center justify-content-between gap-2 small text-light opacity-75">
                                  <span>🆔 ID: <strong class="text-info">#<%= reply.authorId %></strong></span>
                                  <button type="button" class="btn btn-sm btn-outline-info py-0 px-2" style="font-size: 0.7rem;" onclick="event.stopPropagation(); copyTextId('<%= reply.authorId %>', this)">
                                    Copiar
                                  </button>
                                </li>
                              <% } else { %>
                                <li class="px-3 py-1 small text-light opacity-50">
                                  👤 Visitante (sem conta)
                                </li>
                              <% } %>
                              <li><hr class="dropdown-divider border-secondary"></li>
                              <% if (reply.canEdit) { %>
                                <li>
                                  <button type="button" class="dropdown-item small" onclick="toggleEditComment('<%= reply.id %>')">
                                    ✏️ Editar resposta
                                  </button>
                                </li>
                              <% } %>
                              <% if (reply.canDelete) { %>
                                <li>
                                  <form action="/guides/<%= guide.id %>/comments/<%= reply.id %>/delete" method="POST" onsubmit="return confirm('Apagar esta resposta?');">
                                    <button type="submit" class="dropdown-item small text-danger">
                                      🗑️ Excluir resposta
                                    </button>
                                  </form>
                                </li>
                              <% } %>
                              <% if (reply.canEdit || reply.canDelete) { %>
                                <li><hr class="dropdown-divider border-secondary"></li>
                              <% } %>
                              <li>
                                <button type="button" class="dropdown-item small text-warning" onclick="toggleReportComment('<%= reply.id %>')">
                                  ⚠️ Denunciar resposta
                                </button>
                              </li>
                            </ul>
                          </div>
                        </div>
                      </div>

                      <p id="comment-text-<%= reply.id %>" class="text-light mb-1 small" style="white-space: pre-line;"><%= reply.text %></p>

                      <% if (reply.canEdit) { %>
                        <form id="comment-edit-<%= reply.id %>" action="/guides/<%= guide.id %>/comments/<%= reply.id %>/edit" method="POST" class="mt-2 mb-2 d-none">
                          <textarea name="text" rows="2" class="form-control form-control-sm bg-dark text-light border-secondary mb-2" required><%= reply.text %></textarea>
                          <div class="d-flex gap-2 justify-content-end">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleEditComment('<%= reply.id %>')">Cancelar</button>
                            <button type="submit" class="btn btn-primary-custom btn-sm">Salvar</button>
                          </div>
                        </form>
                      <% } %>

                      <form id="comment-report-<%= reply.id %>" action="/guides/<%= guide.id %>/comments/<%= reply.id %>/report" method="POST" class="mt-2 mb-2 p-2 rounded border border-warning bg-dark d-none">
                        <small class="text-warning fw-bold d-block mb-1">⚠️ Denunciar resposta de <%= reply.author %></small>
                        <select name="reason" class="form-select form-select-sm bg-dark text-light border-secondary mb-2">
                          <option value="Spam ou propaganda">Spam ou propaganda</option>
                          <option value="Ofensa ou assédio">Ofensa ou assédio</option>
                          <option value="Spoiler sem aviso">Spoiler sem aviso</option>
                          <option value="Conteúdo inadequado">Conteúdo inadequado</option>
                        </select>
                        <input type="text" name="details" class="form-control form-control-sm bg-dark text-light border-secondary mb-2" placeholder="Detalhes adicionais (opcional)...">
                        <div class="d-flex gap-2 justify-content-end">
                          <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleReportComment('<%= reply.id %>')">Cancelar</button>
                          <button type="submit" class="btn btn-warning btn-sm">Enviar Denúncia</button>
                        </div>
                      </form>

                      <button 
                        type="button" 
                        class="btn btn-sm btn-link text-info p-0 text-decoration-none d-inline-flex align-items-center gap-1" 
                        style="font-size: 0.78rem;"
                        data-parent-id="<%= comment.id %>"
                        data-mention="@<%= reply.author %> "
                        onclick="openReplyForm(this)"
                      >
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="9 17 4 12 9 7"></polyline>
                          <path d="M20 18v-2a4 4 0 0 0-4-4H4"></path>
                        </svg>
                        Responder
                      </button>

                    </div>
                  <% }) %>
                </div>
              <% } %>

            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>

  <script>
    function toggleAccountMode(prefix, checkbox) {
      const input = document.getElementById('author-input-' + prefix);
      if (!input) return;
      if (checkbox.checked) {
        input.value = input.dataset.accountLabel || '';
        input.readOnly = true;
        input.classList.remove('text-light');
        input.classList.add('text-info');
        input.placeholder = '';
      } else {
        input.value = '';
        input.readOnly = false;
        input.classList.remove('text-info');
        input.classList.add('text-light');
        input.placeholder = 'Digite um apelido anônimo (ou deixe vazio para "Anônimo")...';
        input.focus();
      }
    }

    function copyTextId(idValue, btn) {
      if (!idValue) return;
      const done = () => {
        const original = btn.innerHTML;
        btn.innerHTML = '✓';
        setTimeout(() => { btn.innerHTML = original; }, 1200);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(String(idValue)).then(done).catch(done);
      } else {
        const temp = document.createElement('input');
        temp.value = String(idValue);
        document.body.appendChild(temp);
        temp.select();
        document.execCommand('copy');
        document.body.removeChild(temp);
        done();
      }
    }

    function toggleEditComment(commentId) {
      const textEl = document.getElementById('comment-text-' + commentId);
      const formEl = document.getElementById('comment-edit-' + commentId);
      if (textEl && formEl) {
        textEl.classList.toggle('d-none');
        formEl.classList.toggle('d-none');
      }
    }

    function toggleReportComment(commentId) {
      const reportEl = document.getElementById('comment-report-' + commentId);
      if (reportEl) {
        reportEl.classList.toggle('d-none');
      }
    }

    function openReplyForm(btn) {
      const parentId = btn.dataset.parentId;
      const mention = btn.dataset.mention || '';
      const form = document.getElementById('reply-form-' + parentId);
      const textarea = document.getElementById('reply-textarea-' + parentId);
      if (form && textarea) {
        form.classList.remove('d-none');
        if (mention && !textarea.value.startsWith(mention)) {
          textarea.value = mention + textarea.value;
        }
        textarea.focus();
      }
    }

    function closeReplyForm(parentId) {
      const form = document.getElementById('reply-form-' + parentId);
      if (form) {
        form.classList.add('d-none');
      }
    }

    function toggleReplies(btn) {
      const commentId = btn.dataset.commentId;
      const count = Number(btn.dataset.count || 0);
      const list = document.getElementById('replies-list-' + commentId);
      if (list) {
        const hidden = list.classList.toggle('d-none');
        const label = count === 1 ? 'resposta' : 'respostas';
        btn.innerHTML = hidden
          ? '&#9662; Ver ' + count + ' ' + label
          : '&#9652; Ocultar ' + count + ' ' + label;
      }
    }
  </script>
  <%- include('partials/footer') %>
</body>
</html>